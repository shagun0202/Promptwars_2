# SmartElect Environment Variables
# Copy this file to .env and fill in your API keys.
# All keys are optional — the app runs in demo mode without them.

# Gemini AI — from https://aistudio.google.com
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Google Maps (Geocoding + Embed) — from Google Cloud Console
VITE_MAPS_API_KEY=your_maps_api_key_here

# YouTube Data API v3 — from Google Cloud Console
VITE_YOUTUBE_API_KEY=your_youtube_api_key_here

# Google Cloud Text-to-Speech — from Google Cloud Console
VITE_TTS_API_KEY=your_tts_api_key_here

# Google Cloud Translation — from Google Cloud Console
VITE_TRANSLATE_API_KEY=your_translate_api_key_here
